# Copy these names into Vercel > Project > Settings > Environment Variables.
# Never put the real values in this file or in chat.

# Your site's address (no trailing slash)
SITE_URL=https://rafabakes.com

# Supabase > Project Settings > API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe > Developers > API keys (use the test key "sk_test_..." first)
STRIPE_SECRET_KEY=
# Stripe > Developers > Webhooks > your endpoint > Signing secret ("whsec_...")
STRIPE_WEBHOOK_SECRET=

# Shown to customers at checkout
NEXT_PUBLIC_VENMO_HANDLE=
NEXT_PUBLIC_ZELLE_CONTACT=

# Password for rafabakes.com/admin (make it long)
ADMIN_PASSWORD=
